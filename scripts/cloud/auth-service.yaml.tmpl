# Knative service spec for usali-auth (K3): Keycloak + a Cloud SQL Auth
# Proxy SIDECAR (official images only — the JDBC URL points at the
# proxy on localhost, and the proxy authenticates as the runtime SA via
# IAM; no database credentials beyond the keycloak user's own).
# Rendered by deploy_auth.sh (@TOKENS@ substituted), applied with
# `gcloud run services replace`.
#
# Secrets arrive as env FROM SECRET MANAGER (secretKeyRef) — this file
# never carries a credential and is committed as a template.
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: usali-auth
  labels:
    cloud.googleapis.com/location: "@REGION@"
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/minScale: "0"
        autoscaling.knative.dev/maxScale: "2"
        run.googleapis.com/startup-cpu-boost: "true"
        run.googleapis.com/container-dependencies: '{"keycloak": ["cloud-sql-proxy"]}'
    spec:
      serviceAccountName: "usali-app@@PROJECT@.iam.gserviceaccount.com"
      timeoutSeconds: 300
      containers:
        - name: keycloak
          image: "@IMAGE@"
          ports:
            - name: http1
              containerPort: 8080
          env:
            - name: KC_HTTP_ENABLED
              value: "true"
            - name: KC_HTTP_PORT
              value: "8080"
            - name: KC_PROXY_HEADERS
              value: "xforwarded"
            # The public issuer, fixed from day one so tokens never
            # change issuer when DNS lands (K5). Strict hostname stays
            # off until then so the run.app URL can serve the
            # configure_auth pass and pre-DNS smoke.
            - name: KC_HOSTNAME
              value: "https://@AUTH_HOST@"
            - name: KC_HOSTNAME_STRICT
              value: "false"
            - name: KC_DB_URL
              value: "jdbc:postgresql://127.0.0.1:5432/keycloak"
            - name: KC_DB_USERNAME
              value: "keycloak"
            - name: KC_DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: keycloak-db-password
                  key: latest
            - name: KC_BOOTSTRAP_ADMIN_USERNAME
              value: "admin"
            - name: KC_BOOTSTRAP_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: keycloak-admin-password
                  key: latest
          resources:
            limits:
              cpu: "1"
              memory: "1Gi"
          startupProbe:
            tcpSocket:
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 5
            failureThreshold: 58
        - name: cloud-sql-proxy
          image: "gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.14.0"
          args:
            - "--port=5432"
            - "--health-check"
            - "--http-address=0.0.0.0"
            - "--http-port=9801"
            - "@PROJECT@:@REGION@:@SQL_INSTANCE@"
          # container-dependencies requires the depended-on container to
          # declare readiness — the proxy's own health endpoint.
          startupProbe:
            httpGet:
              port: 9801
              path: /startup
            periodSeconds: 2
            failureThreshold: 30
